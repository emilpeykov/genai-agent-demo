# Leave OPENAI_API_KEY unset to run entirely on the built-in mock LLM provider
# (no network calls, no cost) -- useful for local dev, demos, and CI.
OPENAI_API_KEY=

# Which backend to use: "mock" (default), "ollama" (local models), or "openai".
LLM_BACKEND=mock

FAST_MODEL_NAME=gpt-4o-mini
BALANCED_MODEL_NAME=gpt-4o
POWERFUL_MODEL_NAME=o1

# Used when LLM_BACKEND=ollama. Run `ollama serve` and `ollama pull <model>` first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_BALANCED_MODEL=llama3.1:8b
OLLAMA_POWERFUL_MODEL=devstral:24b

REQUEST_TIMEOUT_SECONDS=8
MAX_RETRIES_PER_TIER=2
